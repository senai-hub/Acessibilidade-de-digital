========================================================= */

function gerarResposta(mensagem){

  const texto =
    mensagem
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g,"");


  if(
    texto.includes("o que e acessibilidade") ||
    texto.includes("que e acessibilidade")
  ){

    return `
      📖 <b>Acessibilidade</b> significa criar condições
      para que pessoas com diferentes necessidades possam
      utilizar espaços, serviços, informações e tecnologias
      com autonomia e segurança.
      <br><br>
      O projeto trabalha diferentes tipos de barreiras
      para apoiar a inclusão organizacional.
    `;

  }


  if(
    texto.includes("lei") ||
    texto.includes("lbi") ||
    texto.includes("legislacao") ||
    texto.includes("direito")
  ){

    return `
      ⚖️ Algumas referências relacionadas à acessibilidade
      no Brasil incluem a <b>Lei Brasileira de Inclusão —
      Lei nº 13.146/2015</b>, além de outras normas e
      regulamentações aplicáveis.
      <br><br>
      Para decisões jurídicas ou aplicação de normas,
      consulte a legislação e os responsáveis competentes
      da organização.
    `;

  }


  if(
    texto.includes("ia") ||
    texto.includes("inteligencia artificial")
  ){

    return `
      🤖 Neste projeto, a IA é utilizada como conceito
      de apoio à gestão.
      <br><br>
      O sistema organiza as informações fornecidas,
      classifica a demanda, identifica a prioridade
      informada e apresenta um plano de ação relacionado
      ao tipo de barreira.
    `;

  }


  if(
    texto.includes("capacitismo")
  ){

    return `
      🧠 <b>Capacitismo</b> é a discriminação ou preconceito
      relacionado à deficiência.
      <br><br>
      Ele pode aparecer em atitudes, comportamentos,
      comunicação, processos ou estruturas que criem
      desvantagens para pessoas com deficiência.
    `;

  }


  if(
    texto.includes("pcd") ||
    texto.includes("pessoa com deficiencia")
  ){

    return `
      ♿ O projeto busca apoiar demandas relacionadas
      à acessibilidade de pessoas com deficiência,
      considerando barreiras físicas, comunicacionais,
      tecnológicas, institucionais e atitudinais.
    `;

  }


  if(
    texto.includes("como usar") ||
    texto.includes("como funciona") ||
    texto.includes("etapa")
  ){

    return `
      📋 <b>Como usar o sistema:</b>
      <br><br>
      1️⃣ Escolha o tipo de barreira.
      <br>
      2️⃣ Informe onde acontece.
      <br>
      3️⃣ Selecione a urgência.
      <br>
      4️⃣ Informe seus dados e descreva a situação.
      <br>
      5️⃣ Clique em <b>Processar com IA</b>.
      <br><br>
      Depois disso, o sistema apresenta um protocolo
      e um plano de ação.
    `;

  }


  if(
    texto.includes("registrar") ||
    texto.includes("solicitacao") ||
    texto.includes("pedir") ||
    texto.includes("demanda")
  ){

