function gerarResultado(formulario){

  const agora =
    Date.now()
      .toString()
      .slice(-6);

  protocoloAtual =
    "#AD-"+agora;


  dadosSolicitacao = {

    protocolo:protocoloAtual,

    nome:formulario.nome,

    email:formulario.email,

    setor:formulario.setor,

    descricao:formulario.descricao,

    tipo:dados.tipo,

    local:dados.local,

    urgencia:dados.urgencia,

    prazo:
      prazos[dados.urgencia]

  };


  const plano =
    planos[dados.tipo] ||
    planos.atitudinal;


  document.getElementById(
    "protocolNumber"
  ).textContent =
    protocoloAtual;


  document.getElementById(
    "deadline"
  ).textContent =
    prazos[dados.urgencia];


  document.getElementById(
    "resultContent"
  ).innerHTML = `

    <h4>
      🤖 Plano de Ação gerado
