        </label>

        <input
          id="nome"
          type="text"
          autocomplete="name"
          placeholder="Digite seu nome completo"
        >

      </div>


      <div class="form-group">

        <label for="email">
          E-mail corporativo *
        </label>

        <input
          id="email"
          type="email"
          autocomplete="email"
          placeholder="seuemail@petrobras.com.br"
        >

      </div>


      <div class="form-group">

        <label for="setor">
          Setor / Matrícula
        </label>

        <input
          id="setor"
          type="text"
          placeholder="Ex.: Refinaria - Matrícula 12345"
        >

      </div>


      <div class="form-group">

        <label for="descricao">
          Descreva a barreira *
        </label>

        <textarea
          id="descricao"
          placeholder="Descreva onde acontece, quando acontece, o que está impedindo e quem é afetado..."
        ></textarea>

      </div>

      <p class="form-note">
        🔒 As informações preenchidas devem ser utilizadas conforme as
        políticas de privacidade e proteção de dados da organização.
      </p>

      <div class="actions">

        <button
          class="btn-back"
          onclick="irParaEtapa(3)"
        >
          ← Voltar
        </button>

        <button
          class="btn-system"
          id="processButton"
          onclick="processarDemanda()"
        >
          🤖 Processar com IA
        </button>

      </div>

    </div>


    <!-- ===================================================
         RESULTADO
    ==================================================== -->

    <div class="step" id="resultStep">

      <div class="result">

        <div class="result-check">
          ✓
        </div>

        <h3>
          Demanda registrada
        </h3>

        <p class="result-subtitle">
          A classificação e o plano de ação foram gerados
