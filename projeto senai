          data-value="transporte"
          onclick="selecionarOpcao(this, 'tipo')"
        >
          <span class="option-icon">🚌</span>

          <span class="option-content">
            <strong>Barreira de Transporte</strong>
            <small>
              Locomoção, rotas e veículos adaptados.
            </small>
          </span>
        </button>


        <button
          class="option"
          data-value="institucional"
          onclick="selecionarOpcao(this, 'tipo')"
        >
          <span class="option-icon">📋</span>

          <span class="option-content">
            <strong>Barreira Institucional</strong>
            <small>
              Políticas, normas, processos e procedimentos internos.
            </small>
          </span>
        </button>


        <button
          class="option"
          data-value="atitudinal"
          onclick="selecionarOpcao(this, 'tipo')"
        >
          <span class="option-icon">🧠</span>

