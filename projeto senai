<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Acessibilidade Digital | Gestão Inteligente com IA</title>

<meta
  name="description"
  content="Sistema Inteligente de Gestão de Acessibilidade e Inclusão Organizacional via IA - SENAI MT + Petrobras"
>

<meta name="theme-color" content="#071a38">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
  rel="stylesheet"
>

<style>

/* =========================================================
   VARIÁVEIS
========================================================= */

:root{
  --verde:#008542;
  --verde-2:#00a86b;
  --verde-3:#006b37;

  --amarelo:#ffd100;
  --laranja:#ff9500;

  --azul:#071a38;
  --azul-2:#0a1f44;
  --azul-3:#12396f;

  --bg:#f5f8fc;
  --card:#ffffff;

  --txt:#0a1f44;
  --txt-2:#526174;
  --muted:#718096;

  --borda:rgba(10,31,68,.09);

  --shadow:0 12px 40px rgba(10,31,68,.10);
  --shadow-hover:0 22px 60px rgba(10,31,68,.16);

  --radius:20px;
}

body.dark{
  --bg:#07101f;
  --card:#101b30;

  --txt:#f3f7fb;
  --txt-2:#cbd5e1;
  --muted:#94a3b8;

  --borda:rgba(255,255,255,.09);

  --shadow:0 15px 45px rgba(0,0,0,.30);
  --shadow-hover:0 25px 70px rgba(0,0,0,.45);
}


/* =========================================================
   RESET
========================================================= */

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:"Inter",sans-serif;
}

html{
  scroll-behavior:smooth;
}

body{
  background:var(--bg);
  color:var(--txt);
  line-height:1.6;
  overflow-x:hidden;
  transition:.3s ease;
}

button,
input,
textarea{
  font-family:inherit;
}

button{
  cursor:pointer;
}

a{
  color:inherit;
}

::selection{
  background:var(--amarelo);
  color:var(--azul);
}


/* =========================================================
   ANIMAÇÕES
========================================================= */

@keyframes fadeUp{
  from{
    opacity:0;
    transform:translateY(25px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

@keyframes pulse{
  0%,100%{
    transform:scale(1);
  }
  50%{
    transform:scale(1.06);
  }
}

@keyframes float{
  0%,100%{
    transform:translateY(0);
  }
  50%{
    transform:translateY(-14px);
  }
}

@keyframes gradient{
  0%,100%{
    background-position:0% 50%;
  }
  50%{
    background-position:100% 50%;
  }
}

@keyframes spin{
  to{
    transform:rotate(360deg);
  }
}

@keyframes blink{
  50%{
    opacity:.3;
  }
}

@keyframes shake{
  0%,100%{
    transform:translateX(0);
  }
  25%{
    transform:translateX(-5px);
  }
  75%{
    transform:translateX(5px);
  }
}

@keyframes glow{
  0%,100%{
    box-shadow:0 10px 30px rgba(0,133,66,.25);
  }
  50%{
    box-shadow:0 15px 45px rgba(0,133,66,.55);
  }
}

.reveal{
  opacity:0;
  transform:translateY(35px);
  transition:.8s ease;
}

.reveal.visible{
  opacity:1;
  transform:none;
}


/* =========================================================
   HEADER
========================================================= */

header{
  position:sticky;
  top:0;
  z-index:1000;

  min-height:72px;

  display:flex;
  align-items:center;
  justify-content:space-between;

  padding:12px 28px;

  background:rgba(7,26,56,.94);
  backdrop-filter:blur(18px);

  border-bottom:1px solid rgba(255,255,255,.08);
}

.logo{
  display:flex;
  align-items:center;
  gap:12px;

  color:#fff;
  font-weight:800;
}

.logo-mark{
  width:44px;
  height:44px;

  display:flex;
  align-items:center;
  justify-content:center;

  border-radius:13px;

  background:linear-gradient(
    135deg,
    var(--amarelo),
    var(--laranja)
  );

  color:var(--verde);

  font-size:1.45rem;

  box-shadow:0 8px 25px rgba(255,209,0,.2);

  animation:pulse 3s infinite;
}

.logo-text{
  line-height:1.2;
}

.logo-text strong{
  display:block;
  font-size:.96rem;
}

.logo-text small{
  display:block;
  margin-top:3px;

  font-size:.67rem;
  font-weight:400;

  opacity:.72;
}

nav{
  display:flex;
  align-items:center;
  gap:4px;
}

nav a{
  padding:9px 14px;

  border-radius:10px;

  color:rgba(255,255,255,.84);

  text-decoration:none;

  font-size:.85rem;
  font-weight:600;

  transition:.25s;
}

nav a:hover{
  background:rgba(255,209,0,.12);
  color:var(--amarelo);
}

.header-actions{
  display:flex;
  gap:8px;
}

.icon-btn{
  width:40px;
  height:40px;

  border:1px solid rgba(255,255,255,.12);
  border-radius:10px;

  background:rgba(255,255,255,.07);

  color:#fff;

  transition:.25s;
}

.icon-btn:hover{
  background:rgba(255,209,0,.14);
  color:var(--amarelo);
}

#menuBtn{
  display:none;
}


/* =========================================================
   HERO
========================================================= */

.hero{
  position:relative;
  overflow:hidden;

  padding:90px 24px 105px;

  text-align:center;
  color:#fff;

  background:
    linear-gradient(
      135deg,
      #071a38 0%,
      #0e3267 35%,
      #0066cc 67%,
      #008542 100%
    );

  background-size:300% 300%;

  animation:gradient 18s infinite;
}

.hero::before{
  content:"";

  position:absolute;

  width:500px;
  height:500px;

  left:-180px;
  top:-220px;

  border-radius:50%;

  background:rgba(255,209,0,.16);

  filter:blur(60px);

  animation:float 12s infinite;
}

.hero::after{
  content:"";

  position:absolute;

  width:500px;
  height:500px;

  right:-180px;
  bottom:-240px;

  border-radius:50%;

  background:rgba(0,168,107,.22);

  filter:blur(65px);

  animation:float 15s infinite reverse;
}

.hero-content{
  position:relative;
  z-index:2;

  max-width:920px;
  margin:auto;

  animation:fadeUp 1s ease;
}

.hero-badge{
  display:inline-flex;
  align-items:center;
  gap:8px;

  padding:8px 17px;

  margin-bottom:24px;

  border:1px solid rgba(255,209,0,.35);
  border-radius:50px;

  background:rgba(255,209,0,.08);

  font-size:.78rem;
  font-weight:600;

  backdrop-filter:blur(10px);
}

.hero-dot{
  width:8px;
  height:8px;

  border-radius:50%;

  background:var(--amarelo);

  animation:pulse 2s infinite;
}

.hero h1{
  margin-bottom:20px;

  font-size:clamp(2.1rem,5.5vw,3.7rem);

  line-height:1.08;

  letter-spacing:-.045em;
}

.hero h1 span{
  background:
    linear-gradient(
      90deg,
      var(--amarelo),
      var(--laranja),
      var(--amarelo)
    );

  background-size:200% auto;

  -webkit-background-clip:text;
  background-clip:text;

  -webkit-text-fill-color:transparent;

  animation:gradient 4s linear infinite;
}

.hero-description{
  max-width:720px;
  margin:0 auto 32px;

  color:rgba(255,255,255,.88);

  font-size:1.03rem;
}

.hero-buttons{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:12px;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:9px;

  min-height:50px;

  padding:14px 27px;

  border-radius:50px;

  border:none;

  font-size:.9rem;
  font-weight:800;

  text-decoration:none;

  transition:.25s;
}

.btn-primary-yellow{
  background:linear-gradient(
    135deg,
    var(--amarelo),
    var(--laranja)
  );

  color:var(--azul);

  box-shadow:0 10px 30px rgba(255,209,0,.28);
}

.btn-primary-yellow:hover{
  transform:translateY(-3px);
  box-shadow:0 16px 40px rgba(255,209,0,.4);
}

.btn-glass{
  color:#fff;

  border:1px solid rgba(255,255,255,.25);

  background:rgba(255,255,255,.08);

  backdrop-filter:blur(10px);
}

.btn-glass:hover{
  border-color:var(--amarelo);
  color:var(--amarelo);
  background:rgba(255,255,255,.13);
}

.hero-stats{
  max-width:700px;

  display:grid;
  grid-template-columns:repeat(3,1fr);

  gap:14px;

  margin:48px auto 0;
}

.hero-stat{
  padding:17px;

  border:1px solid rgba(255,255,255,.1);
  border-radius:16px;

  background:rgba(255,255,255,.06);

  backdrop-filter:blur(12px);
}

.hero-stat strong{
  display:block;

  color:var(--amarelo);

  font-size:1.45rem;
}

.hero-stat span{
  display:block;

  margin-top:2px;

  font-size:.74rem;

  opacity:.82;
}


/* =========================================================
   SEÇÕES
========================================================= */

.section{
  max-width:1160px;

  margin:auto;

  padding:82px 24px;
}

.section-header{
  text-align:center;

  margin-bottom:45px;
}

.tag{
  display:inline-flex;

  padding:6px 13px;

  margin-bottom:11px;

  border-radius:50px;

  background:rgba(0,133,66,.09);

  color:var(--verde);

  font-size:.72rem;
  font-weight:800;

  letter-spacing:.07em;

  text-transform:uppercase;
}

.section-header h2{
  margin-bottom:10px;

  font-size:clamp(1.7rem,4vw,2.4rem);

  letter-spacing:-.035em;
}

.section-header p{
  max-width:650px;

  margin:auto;

  color:var(--txt-2);

  font-size:.95rem;
}


/* =========================================================
   SISTEMA
========================================================= */

.system-card{
  max-width:850px;

  margin:auto;

  padding:38px 34px;

  background:var(--card);

  border:1px solid var(--borda);

  border-radius:25px;

  box-shadow:0 25px 70px rgba(10,31,68,.11);
}

.progress{
  display:grid;
  grid-template-columns:repeat(4,1fr);

  gap:8px;

  margin-bottom:12px;
}

.progress-item{
  height:7px;

  border-radius:10px;

  background:rgba(10,31,68,.08);

  transition:.4s;
}

.progress-item.active{
  background:
    linear-gradient(
      90deg,
      var(--verde),
      var(--amarelo)
    );

  box-shadow:0 0 16px rgba(0,133,66,.25);
}

.step-label{
  margin-bottom:28px;

  text-align:center;

  color:var(--txt-2);

  font-size:.8rem;
}

.step-label strong{
  color:var(--verde);
}

.step{
  display:none;

  animation:fadeUp .45s ease;
}

.step.active{
  display:block;
}

.question-title{
  margin-bottom:6px;

  font-size:1.4rem;
  font-weight:800;
}

.question-description{
  margin-bottom:22px;

  color:var(--txt-2);

  font-size:.88rem;
}

.options{
  display:grid;
  gap:11px;
}

.option{
  position:relative;

  width:100%;

  display:flex;
  align-items:center;

  gap:14px;

  padding:16px 18px;

  text-align:left;

  color:var(--txt);

  background:var(--bg);

  border:2px solid var(--borda);

  border-radius:15px;

  transition:.25s;
}

.option:hover{
  transform:translateX(4px);

  border-color:var(--verde);

  background:rgba(0,133,66,.045);
}

.option.selected{
  border-color:var(--verde);

  background:rgba(0,133,66,.08);

  box-shadow:
    0 0 0 3px rgba(0,133,66,.1);
}

.option.selected::after{
  content:"✓";

  position:absolute;

  right:17px;

  color:var(--verde);

  font-size:1.15rem;
  font-weight:900;
}

.option-icon{
  width:42px;
  height:42px;

  flex-shrink:0;

  display:flex;
  align-items:center;
  justify-content:center;

  border-radius:12px;

  background:
    linear-gradient(
      135deg,
      rgba(0,133,66,.12),
      rgba(255,209,0,.12)
    );

  font-size:1.35rem;
}

.option-content strong{
  display:block;

  margin-bottom:2px;

  font-size:.91rem;
}

.option-content small{
  color:var(--txt-2);

  font-size:.77rem;
}

.form-group{
  display:flex;
  flex-direction:column;

  gap:7px;

  margin-bottom:15px;
}

.form-group label{
  font-size:.84rem;
  font-weight:700;
}

.form-group input,
.form-group textarea{
  width:100%;

  padding:13px 15px;

  border:2px solid var(--borda);
  border-radius:12px;

  outline:none;

  background:var(--bg);
  color:var(--txt);

  font-size:.88rem;

  transition:.25s;
}

.form-group input:focus,
.form-group textarea:focus{
  border-color:var(--verde);

  box-shadow:
    0 0 0 4px rgba(0,133,66,.1);
}

.form-group textarea{
  min-height:125px;

  resize:vertical;
}

.form-note{
  margin:5px 0 15px;

  color:var(--muted);

  font-size:.72rem;
}

.actions{
  display:flex;

  gap:10px;

  margin-top:23px;
}

.btn-system{
  flex:1;

  min-height:50px;

  padding:14px 22px;

  border:none;

  border-radius:50px;

  background:
    linear-gradient(
      135deg,
      var(--verde),
      var(--verde-2)
    );

  color:#fff;

  font-weight:800;

  transition:.25s;
}

.btn-system:hover:not(:disabled){
  transform:translateY(-2px);

  box-shadow:0 12px 30px rgba(0,133,66,.35);
}

.btn-system:disabled{
  opacity:.45;

  cursor:not-allowed;
}

.btn-system.ready{
  animation:glow 2s infinite;
}

.btn-back{
  min-height:50px;

  padding:13px 22px;

  border:2px solid var(--borda);

  border-radius:50px;

  background:transparent;

  color:var(--txt);

  font-weight:700;
}

.btn-back:hover{
  border-color:var(--verde);
  color:var(--verde);
}


/* =========================================================
   RESULTADO
========================================================= */

.result{
  overflow:hidden;

  padding:35px 27px;

  color:#fff;

  border-radius:21px;

  background:
    linear-gradient(
      135deg,
      #00773b,
      #00a86b
    );
}

.result-check{
  width:70px;
  height:70px;

  display:flex;
  align-items:center;
  justify-content:center;

  margin:0 auto 17px;

  border-radius:50%;

  background:var(--amarelo);

  color:var(--verde);

  font-size:2.2rem;
  font-weight:900;

  animation:pulse 2s infinite;
}

.result h3{
  margin-bottom:5px;

  text-align:center;

  font-size:1.55rem;
}

.result-subtitle{
  text-align:center;

  font-size:.86rem;

  opacity:.9;
}

.protocol{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:10px;

  width:max-content;

  max-width:100%;

  margin:17px auto;

  padding:10px 17px;

  border-radius:50px;

  background:rgba(0,0,0,.18);

  font-family:monospace;

  font-weight:800;

  letter-spacing:.8px;
}

.protocol button{
  border:0;

  background:transparent;

  color:#fff;

  font-size:.95rem;
}

.result-box{
  margin-top:17px;

  padding:19px;

  border:1px solid rgba(255,255,255,.2);
  border-radius:16px;

  background:rgba(255,255,255,.12);

  backdrop-filter:blur(10px);
}

.result-box h4{
  margin-bottom:10px;

  font-size:.95rem;
}

.result-box ul{
  padding:0;

  list-style:none;
}

.result-box li{
  position:relative;

  padding:6px 0 6px 22px;

  font-size:.83rem;
}

.result-box li::before{
  content:"✓";

  position:absolute;

  left:0;

  color:var(--amarelo);

  font-weight:900;
}

.result-tags{
  display:flex;
  flex-wrap:wrap;

  gap:6px;

  margin-top:12px;
}

.result-tag{
  padding:5px 10px;

  border-radius:20px;

  background:rgba(0,0,0,.2);

  font-size:.7rem;
  font-weight:700;
}

.result-info{
  margin-top:14px;

  padding:14px;

  border-radius:12px;

  background:rgba(0,0,0,.15);

  text-align:center;

  font-size:.8rem;
}

.result-actions{
  display:flex;

  flex-wrap:wrap;

  justify-content:center;

  gap:9px;

  margin-top:17px;
}

.result-actions button{
  padding:10px 16px;

  border:1px solid rgba(255,255,255,.25);
  border-radius:50px;

  background:rgba(255,255,255,.1);

  color:#fff;

  font-weight:700;
}

.result-actions button:hover{
  background:rgba(255,255,255,.2);
}


/* =========================================================
   CARDS
========================================================= */

.cards{
  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(230px,1fr));

  gap:18px;
}

.card{
  position:relative;

  overflow:hidden;

  padding:25px;

  border:1px solid var(--borda);
  border-radius:20px;

  background:var(--card);

  box-shadow:var(--shadow);

  transition:.35s;
}

.card:hover{
  transform:translateY(-6px);

  box-shadow:var(--shadow-hover);
}

.card-icon{
  width:52px;
  height:52px;

  display:flex;
  align-items:center;
  justify-content:center;

  margin-bottom:15px;

  border-radius:14px;

  background:
    linear-gradient(
      135deg,
      rgba(0,133,66,.12),
      rgba(255,209,0,.14)
    );

  font-size:1.45rem;
}

.card h3{
  margin-bottom:6px;

  font-size:.98rem;
}

.card p{
  color:var(--txt-2);

  font-size:.83rem;
}


/* =========================================================
   SOBRE
========================================================= */

.about-box{
  max-width:850px;

  margin:auto;

  padding:35px;

  text-align:center;

  border:1px solid var(--borda);
  border-radius:24px;

  background:var(--card);

  box-shadow:var(--shadow);
}

.about-box p{
  color:var(--txt-2);

  font-size:.9rem;
}

.about-highlight{
  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(180px,1fr));

  gap:12px;

  margin-top:25px;
}

.about-item{
  padding:17px;

  border-radius:15px;

  background:var(--bg);
}

.about-item strong{
  display:block;

  color:var(--verde);

  font-size:.82rem;
}

.about-item span{
  display:block;

  margin-top:4px;

  color:var(--txt-2);

  font-size:.76rem;
}


/* =========================================================
   CHAT
========================================================= */

#chatButton{
  position:fixed;

  right:22px;
  bottom:22px;

  z-index:900;

  width:62px;
  height:62px;

  border:0;
  border-radius:50%;

  background:
    linear-gradient(
      135deg,
      var(--verde),
      var(--verde-2)
    );

  color:#fff;

  font-size:1.45rem;

  box-shadow:0 13px 35px rgba(0,133,66,.4);

  animation:pulse 2.5s infinite;
}

#chatWindow{
  position:fixed;

  right:22px;
  bottom:96px;

  z-index:899;

  width:390px;
  max-width:calc(100vw - 30px);

  height:610px;
  max-height:calc(100vh - 125px);

  display:none;
  flex-direction:column;

  overflow:hidden;

  border-radius:22px;

  background:var(--card);

  box-shadow:0 30px 80px rgba(0,0,0,.3);
}

#chatWindow.open{
  display:flex;

  animation:fadeUp .3s ease;
}

.chat-header{
  display:flex;
  align-items:center;

  gap:11px;

  padding:15px 17px;

  color:#fff;

  background:
    linear-gradient(
      135deg,
      var(--azul-2),
      var(--verde)
    );
}

.chat-avatar{
  width:42px;
  height:42px;

  display:flex;
  align-items:center;
  justify-content:center;

  border-radius:50%;

  background:
    linear-gradient(
      135deg,
      var(--amarelo),
      var(--laranja)
    );

  font-size:1.25rem;
}

.chat-title{
  flex:1;
}

.chat-title strong{
  display:block;

  font-size:.9rem;
}

.chat-title small{
  opacity:.8;

  font-size:.68rem;
}

.chat-close{
  border:0;

  background:none;

  color:#fff;

  font-size:1.45rem;
}

.chat-body{
  flex:1;

  display:flex;
  flex-direction:column;

  gap:10px;

  overflow-y:auto;

  padding:15px;

  background:var(--bg);
}

.message{
  max-width:84%;

  padding:10px 14px;

  border-radius:16px;

  font-size:.82rem;

  line-height:1.5;

  animation:fadeUp .25s ease;
}

.message.bot{
  align-self:flex-start;

  border:1px solid var(--borda);

  border-bottom-left-radius:5px;

  background:var(--card);

  color:var(--txt);
}

.message.user{
  align-self:flex-end;

  border-bottom-right-radius:5px;

  background:
    linear-gradient(
      135deg,
      var(--verde),
      var(--verde-2)
    );

  color:#fff;
}

.typing{
  display:flex;

  gap:4px;

  padding:13px 16px;
}

.typing span{
  width:7px;
  height:7px;

  border-radius:50%;

  background:#94a3b8;

  animation:blink 1.2s infinite;
}

.typing span:nth-child(2){
  animation-delay:.2s;
}

.typing span:nth-child(3){
  animation-delay:.4s;
}

.quick-replies{
  display:flex;
  flex-wrap:wrap;

  gap:5px;

  padding:9px 12px;

  border-top:1px solid var(--borda);

  background:var(--card);
}

.quick-replies button{
  padding:5px 9px;

  border:1px solid rgba(0,133,66,.25);
  border-radius:50px;

  background:rgba(0,133,66,.07);

  color:var(--verde);

  font-size:.68rem;
}

.quick-replies button:hover{
  background:var(--verde);

  color:#fff;
}

.chat-input{
  display:flex;

  gap:8px;

  padding:10px;

  border-top:1px solid var(--borda);

  background:var(--card);
}

.chat-input input{
  flex:1;

  padding:11px 15px;

  border:1px solid var(--borda);
  border-radius:50px;

  outline:none;

  background:var(--bg);

  color:var(--txt);

  font-size:.82rem;
}

.chat-input input:focus{
  border-color:var(--verde);
}

.chat-send{
  width:42px;
  height:42px;

  flex-shrink:0;

  border:0;
  border-radius:50%;

  background:
    linear-gradient(
      135deg,
      var(--verde),
      var(--verde-2)
    );

  color:#fff;
}


/* =========================================================
   TOAST
========================================================= */

#toast{
  position:fixed;

  left:50%;
  bottom:25px;

  z-index:2000;

  transform:translate(-50%,20px);

  padding:12px 18px;

  border-radius:12px;

  background:#071a38;

  color:#fff;

  font-size:.8rem;
  font-weight:700;

  opacity:0;

  pointer-events:none;

  transition:.3s;
}

#toast.show{
  opacity:1;

  transform:translate(-50%,0);
}


/* =========================================================
   FOOTER
========================================================= */

footer{
  padding:50px 24px 25px;

  background:var(--azul);

  color:#fff;

  text-align:center;
}

footer strong{
  display:block;

  margin-bottom:7px;

  font-size:.9rem;
}

footer p{
  margin-bottom:5px;

  color:rgba(255,255,255,.72);

  font-size:.78rem;
}

footer a{
  color:var(--amarelo);

  text-decoration:none;
}

.footer-bottom{
  max-width:800px;

  margin:22px auto 0;

  padding-top:18px;

  border-top:1px solid rgba(255,255,255,.08);

  color:rgba(255,255,255,.45);

  font-size:.7rem;
}


/* =========================================================
