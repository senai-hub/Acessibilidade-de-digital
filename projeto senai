      <span class="result-tag">
        ⚡ ${urgencias[dados.urgencia]}
      </span>

    </div>

  `;


  localStorage.setItem(
    "ultimaDemanda",
    JSON.stringify(dadosSolicitacao)
  );


  document
    .querySelectorAll(".step")
    .forEach(step =>
      step.classList.remove("active")
    );


  document
    .getElementById("resultStep")
    .classList.add("active");


  atualizarProgresso(4);


  document
    .getElementById("sistema")
    .scrollIntoView({
      behavior:"smooth",
      block:"start"
    });


  mostrarToast(
    "Demanda processada com sucesso."
