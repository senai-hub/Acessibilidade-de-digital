if(localStorage.getItem("tema")==="dark"){

  document.body.classList.add("dark");

  document.getElementById("themeBtn").textContent="☀️";

}


/* =========================================================
   REVEAL
========================================================= */

const observer =
  new IntersectionObserver(
    entries => {

      entries.forEach(entry => {

        if(entry.isIntersecting){

          entry.target.classList.add("visible");

          observer.unobserve(entry.target);

        }

      });

    },
    {
      threshold:.12
    }
  );


document
  .querySelectorAll(".reveal")
  .forEach(el => observer.observe(el));


/* =========================================================
   SELEÇÃO DAS OPÇÕES
========================================================= */

function selecionarOpcao(botao, campo){

  const etapa =
    botao.closest(".step");

  etapa
    .querySelectorAll(".option")
    .forEach(item =>
      item.classList.remove("selected")
    );

  botao.classList.add("selected");

  dados[campo] =
    botao.dataset.value;


  if(campo==="tipo"){

    ativarBotao("next1");

  }

  if(campo==="local"){

    ativarBotao("next2");

  }

  if(campo==="urgencia"){

    ativarBotao("next3");

  }

}


function ativarBotao(id){

  const botao =
    document.getElementById(id);

  botao.disabled=false;

  botao.classList.add("ready");

}


/* =========================================================
   NAVEGAÇÃO DAS ETAPAS
========================================================= */

function irParaEtapa(numero){

  if(numero===2 && !dados.tipo){

    mostrarToast("Selecione o tipo de barreira.");

    return;

  }

  if(numero===3 && !dados.local){

    mostrarToast("Selecione o local da ocorrência.");

    return;

  }

  if(numero===4 && !dados.urgencia){

    mostrarToast("Selecione o nível de urgência.");

    return;

  }


  document
    .querySelectorAll(".step")
    .forEach(step =>
      step.classList.remove("active")
    );


  const destino =
    numero <= 4
      ? document.getElementById("step"+numero)
      : document.getElementById("resultStep");


  if(destino){

    destino.classList.add("active");

  }


  atualizarProgresso(numero);

  document
    .getElementById("sistema")
    .scrollIntoView({
      behavior:"smooth",
      block:"start"
    });

}


function atualizarProgresso(numero){

  const etapa =
    Math.min(numero,4);

  for(let i=1;i<=4;i++){

    const barra =
      document.getElementById("progress"+i);

    barra.classList.toggle(
      "active",
      i<=etapa
    );

  }


  document.getElementById(
    "stepNumber"
  ).textContent=etapa;


  document.getElementById(
    "stepName"
  ).textContent=
    nomesEtapas[etapa] ||
    "Resultado";

}


/* =========================================================
   PROCESSAR DEMANDA
========================================================= */

function processarDemanda(){

  const nome =
    document.getElementById("nome")
      .value.trim();

  const email =
    document.getElementById("email")
      .value.trim();

  const setor =
    document.getElementById("setor")
      .value.trim();

  const descricao =
    document.getElementById("descricao")
      .value.trim();


  if(!nome){

    mostrarToast(
      "Informe seu nome completo."
    );

    destacarCampo("nome");

    return;

  }


  if(!email || !validarEmail(email)){

    mostrarToast(
      "Informe um e-mail válido."
    );

    destacarCampo("email");

    return;

  }


  if(!descricao){

    mostrarToast(
      "Descreva a barreira identificada."
    );

    destacarCampo("descricao");

    return;

  }


  if(
    !dados.tipo ||
    !dados.local ||
    !dados.urgencia
  ){

    mostrarToast(
      "Complete todas as etapas anteriores."
    );

    return;

  }


  const botao =
    document.getElementById(
      "processButton"
    );


  botao.disabled=true;

  botao.innerHTML =
    '<span style="display:inline-flex;align-items:center;gap:8px">' +
    '<span class="spinner"></span>' +
    'Processando...' +
    '</span>';


  setTimeout(() => {

    gerarResultado({
      nome,
      email,
      setor,
      descricao
    });

    botao.disabled=false;

    botao.innerHTML =
      "🤖 Processar com IA";

  },1200);

}


function validarEmail(email){

  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/
    .test(email);

}


function destacarCampo(id){

  const campo =
    document.getElementById(id);

  campo.classList.remove("shake");

  void campo.offsetWidth;

  campo.classList.add("shake");

  campo.focus();

}


